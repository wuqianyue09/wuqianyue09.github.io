---
import "../styles/global.css";
import LocalTime from "../components/LocalTime.astro";
import Timeline from "../components/Timeline.astro";
import { education, publications, researchExperience, researchInterests } from "../data/profile";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Qianyue Wu — studying statistics and the theoretical foundations of machine learning." />
    <meta property="og:title" content="Qianyue Wu" />
    <meta property="og:description" content="Statistics, machine learning theory, and the ideas behind attention." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>Qianyue Wu</title>
  </head>
  <body>
    <main>
      <header>
        <h1>Qianyue Wu</h1>
        <p class="updated">Updated <time datetime="2026-09-29">Sep 29, 2026</time></p>
      </header>

      <div class="intro">
        <p>I study statistics and machine learning.</p>
        <p>
          I’m a master’s student in Applied Statistics at
          <a href="https://english.bnu.edu.cn/">Beijing Normal University at Zhuhai</a>.
          I hope to pursue a PhD in Machine Learning or Statistics.
        </p>
        <p>
          You can find me on <a href="https://github.com/wuqianyue09">GitHub</a>
          and <a href="https://www.zhihu.com/people/wuqianyue">Zhihu</a>.
        </p>
      </div>

      <section aria-labelledby="interests-heading">
        <h2 id="interests-heading">Research Interests</h2>
        <p class="interests-copy">{researchInterests}</p>
      </section>

      <Timeline
        id="research-experience"
        title="Research Experience"
        entries={researchExperience}
        emptyMessage="Research Experience will be added here."
      />

      <Timeline
        id="education"
        title="Education Background"
        entries={education}
        emptyMessage="Education details will be added here."
      />

      <Timeline
        id="publications"
        title="Publications"
        entries={publications}
        emptyMessage="Coming soon."
      />

      <LocalTime />
    </main>
  </body>
</html>
