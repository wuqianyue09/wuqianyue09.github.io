<footer class="local-time" data-local-time>
  <p><time hidden></time><span class="location">in Beijing, China</span></p>
  <svg class="cat" viewBox="0 0 76 60" role="img" aria-label="A little cat" data-cat>
    <g class="awake-cat">
      <path class="tail" d="M49 47c13 4 19-3 16-9-1-3-5-3-6-1" />
      <!-- One soft silhouette: ears, cheeks and body, without a neck seam. -->
      <path class="outline" d="M23 49c-8-3-7-13-4-22l-1-12q0-3 3-1l9 6q7-2 14 0l8-6q3-2 3 1l-1 13c4 10 4 18-3 21-7 3-21 3-28 0Z" />
      <g class="eyes">
        <circle cx="29" cy="32" r="1.2" />
        <circle cx="44" cy="32" r="1.2" />
      </g>
      <path d="M33 37q2 3 4 0 2 3 4 0" />
    </g>
    <g class="sleeping-cat">
      <g class="breathing">
        <path class="outline" d="M18 49c-6-3-7-9-4-15l-1-9q0-2 2-1l8 6q5-1 10 1l7-5q2-1 2 1v7c12-5 22 0 23 8 1 7-7 10-17 10H29q-7 0-11-3Z" />
        <path d="M19 39q2.5 3 5 0m7 0q2.5 3 5 0" />
        <path class="sleep-tail" d="M61 43q-1 7-14 5" />
      </g>
      <path class="sleep-z" aria-hidden="true" d="M49 21h5l-5 6h5" />
    </g>
  </svg>
</footer>

<script>
  import { getBeijingTime } from "../lib/beijing-time";

  const footer = document.querySelector<HTMLElement>("[data-local-time]");
  const clock = footer?.querySelector("time");
  const cat = footer?.querySelector("[data-cat]");

  if (footer && clock && cat) {
    let timer: ReturnType<typeof setTimeout>;

    const update = () => {
      clearTimeout(timer);
      const now = new Date();
      const { label, sleeping } = getBeijingTime(now);
      clock.textContent = label;
      clock.dateTime = now.toISOString();
      clock.hidden = false;
      footer.dataset.state = sleeping ? "sleeping" : "awake";
      cat.setAttribute("aria-label", sleeping ? "A sleeping cat" : "An awake cat");
      // Refresh on the next minute boundary, including midnight and 08:00.
      timer = setTimeout(update, 60_000 - (Date.now() % 60_000));
    };

    update();
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) clearTimeout(timer);
      else update();
    });
    window.addEventListener("pagehide", () => clearTimeout(timer));
    window.addEventListener("pageshow", update);
  }
</script>

<style>
  .local-time {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 54px;
    color: var(--muted);
    font-size: 12px;
  }
  p { display: flex; flex-wrap: wrap; column-gap: 5px; }
  time { font-variant-numeric: tabular-nums; }
  .cat {
    flex: 0 0 64px;
    width: 64px;
    height: 51px;
    fill: none;
    stroke: #85847d;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .outline { fill: #fdfdfc; }
  .eyes circle { fill: #85847d; stroke: none; }
  .sleeping-cat { display: none; }
  [data-state="sleeping"] .awake-cat { display: none; }
  [data-state="sleeping"] .sleeping-cat { display: inline; }
  .eyes { transform-origin: 36px 32px; animation: blink 6s infinite; }
  .breathing { transform-origin: 38px 53px; animation: breathe 4s ease-in-out infinite; }
  .sleep-z { animation: drift 4s ease-in-out infinite; }
  @keyframes blink { 0%, 43%, 47%, 100% { transform: scaleY(1); } 45% { transform: scaleY(.1); } }
  @keyframes breathe { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(.95); } }
  @keyframes drift { 0%, 100% { opacity: .35; transform: translateY(1px); } 50% { opacity: .85; transform: translateY(-2px); } }
  @media (max-width: 600px) { .local-time { margin-top: 38px; } }
  @media (prefers-reduced-motion: reduce) { .eyes, .breathing, .sleep-z { animation: none; } }
</style>
